{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rpress/service-bar",
	"title": "Service Bar",
	"category": "restropress",
	"description": "Delivery or pickup choice with the order date and time.",
	"keywords": [
		"delivery",
		"pickup",
		"time",
		"service"
	],
	"textdomain": "restropress",
	"supports": {
		"html": false,
		"interactivity": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "rpress-storefront-blocks-editor",
	"style": "rpress-storefront-blocks",
	"viewScriptModule": "@restropress/storefront",
	"render": "file:./render.php"
}

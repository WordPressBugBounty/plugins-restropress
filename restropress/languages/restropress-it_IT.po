msgstr "Seleziona questa opzione per visualizzare <b><i>Accetto i termini</i></b> al momento del pagamento, che gli utenti devono selezionare prima di creare ordini."

#: includes/admin/settings/register-settings.php:1177
msgid "Agree to Terms Label"
msgstr "Etichetta Accetta i termini"


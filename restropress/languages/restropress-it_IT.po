msgstr "Se <b><i>Agree to Terms</i></b> viene cliccato, inserisci i termini dell'accordo qui."

#: includes/admin/settings/register-settings.php:1204
msgid "Realtime Setup Guide"
msgstr "Guida alla configurazione in tempo reale"

#: includes/admin/settings/register-settings.php:1206
msgid "Enable realtime updates, enter your websocket provider credentials, then save settings. For Pusher Cloud, App ID, Key, Secret, Cluster and TLS are usually enough."
msgstr "Abilita gli aggiornamenti in tempo reale, inserisci le credenziali del tuo provider websocket, quindi salva le impostazioni. Per Pusher Cloud, di solito sono sufficienti App ID, Key, Secret, Cluster e TLS."

#: includes/admin/settings/register-settings.php:1210
msgid "Enable Realtime Updates"

msgstr "Le app esterne possono quindi autenticarsi con il nome utente WordPress e la password applicativa tramite l’autenticazione HTTP Basic."

#: includes/admin/settings/register-settings.php:446
msgid "3. Call the RestroPress REST endpoints."
msgstr "3. Richiama gli endpoint REST di RestroPress."

#: includes/admin/settings/register-settings.php:447
msgid "The current API includes food items, orders, cart, customers, reports, services/status/tax helpers, categories, and add-ons under the rp/v1 namespace."
msgstr "L’API attuale include elementi del menu, ordini, carrello, clienti, report, helper per servizi/stato/imposte, categorie e aggiunte sotto il namespace rp/v1."

#: includes/admin/settings/register-settings.php:449
msgid "Open User Profile"
msgstr "Apri profilo utente"

#: includes/admin/settings/register-settings.php:451
msgid "View REST API Postman documentation"
msgstr "Visualizza la documentazione Postman dell’API REST"

#: includes/admin/settings/register-settings.php:457
msgid "About the token endpoint"
msgstr "Informazioni sull’endpoint del token"

#. translators: 1: REST API auth endpoint URL.
#: includes/admin/settings/register-settings.php:462

msgstr "Apri %1$s, trova Password applicative, aggiungi un nome per l’integrazione e copia immediatamente la password generata."

#: includes/admin/settings/register-settings.php:443
msgid "your WordPress user profile"
msgstr "il tuo profilo utente WordPress"

#: includes/admin/settings/register-settings.php:445

#: includes/admin/settings/register-settings.php:1085
msgid "Enable Taxes"
msgstr "Abilita Tasse"

#: includes/admin/settings/register-settings.php:1086
msgid "Check this to enable taxes on purchases."
msgstr "Seleziona questo per abilitare l'iva sugli acquisti."

#: includes/admin/settings/register-settings.php:1088
msgid "Enabling Taxes"
msgstr "Abilitazione delle tasse"

#: includes/admin/settings/register-settings.php:1089
msgid "With taxes enabled, RestroPress will use the rules below to charge tax to customers. With taxes enabled, customers are required to input their address on checkout so that taxes can be properly calculated."
msgstr "Con le imposte abilitate, RestroPress userà le regole seguenti per addebitare le imposte ai clienti. Con le imposte abilitate, i clienti devono inserire il proprio indirizzo al checkout affinché le imposte possano essere calcolate correttamente."

#: includes/admin/settings/register-settings.php:1093
msgid "Tax Name"
msgstr "Nome dell’imposta"

#: includes/admin/settings/register-settings.php:1094
msgid "Global tax name that would be use through out the site"
msgstr "Nome fiscale globale che verrebbe utilizzato in tutto il sito"

#: includes/admin/settings/register-settings.php:1099 includes/admin/settings/register-settings.php:1103
msgid "Tax rate"
msgstr "Aliquota fiscale"

#: includes/admin/settings/register-settings.php:1100
msgid "When tax rate is enabled this tax rate will be charged to the customers. Enter a percentage, such as 6.5 for 6.5%. "
msgstr "Quando l’aliquota fiscale è abilitata, questa aliquota verrà addebitata ai clienti. Inserisci una percentuale, ad esempio 6.5 per 6,5%. "

#: includes/admin/settings/register-settings.php:1104
msgid "This would be the default tax rate for the customers who will purchase in your store"
msgstr "Questa è l’aliquota fiscale predefinita per i clienti che acquisteranno nel tuo negozio"

#: includes/admin/settings/register-settings.php:1108
msgid "Display fooditems in shop"
msgstr "Mostra articoli alimentare nel nnegozio"

#: includes/admin/settings/register-settings.php:1109
msgid "When tax_item is enabled this tax_item will be charged to the customers. Select tax type, such as Including/Excluding tax. "
msgstr "Quando tax_item è abilitato, questo tax_item verrà addebitato ai clienti. Seleziona il tipo di imposta, ad esempio Imposta inclusa/esclusa. "

#: includes/admin/settings/register-settings.php:1113
msgid "Including tax"
msgstr "Tassa inclusa "

#: includes/admin/settings/register-settings.php:1114
msgid "Excluding tax"
msgstr "Escludere le imposte"

#: includes/admin/settings/register-settings.php:1117
msgid "tax_item"
msgstr "tax_item"

#: includes/admin/settings/register-settings.php:1118
msgid "This would be the default tax_item for the restaurant who will set product Including/Excluding Tax"
msgstr "Questo è il tax_item predefinito per il ristorante che imposterà il prodotto con imposta inclusa/esclusa"

#: includes/admin/settings/register-settings.php:1122
msgid "Prices entered with tax"
msgstr "Prezzi inseriti con l'iva"

#: includes/admin/settings/register-settings.php:1123
msgid "This option affects how you enter prices."
msgstr "Questa opzione influisce su come inserisci i prezzi."

#: includes/admin/settings/register-settings.php:1127
msgid "Yes, I will enter prices inclusive of tax"
msgstr "Sì, inserirò i prezzi comprensivi di imposta"

#: includes/admin/settings/register-settings.php:1128
msgid "No, I will enter prices exclusive of tax"
msgstr "No, inserisco il prezzo senza Iva"


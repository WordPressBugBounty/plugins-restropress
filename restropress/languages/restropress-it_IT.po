msgstr "Consenti agli utenti autenticati e autorizzati di richiedere un token RestroPress da %1$s. Questo non controlla le normali route dell’API REST di WordPress."

#: includes/admin/settings/register-settings.php:434
msgid "Recommended connection flow"
msgstr "Flusso di connessione consigliato"

#: includes/admin/settings/register-settings.php:437
msgid "1. Choose the WordPress user the integration should act as."
msgstr "1. Scegli l’utente WordPress con cui l’integrazione deve operare."

#: includes/admin/settings/register-settings.php:438
msgid "Use the least-privileged user that still has permission to access the data or actions the integration needs."
msgstr "Usa l’utente con i privilegi minimi che dispone comunque dell’autorizzazione ad accedere ai dati o alle azioni necessarie all’integrazione."

#: includes/admin/settings/register-settings.php:439
msgid "2. Create a WordPress Application Password."
msgstr "2. Crea una password applicativa di WordPress."

#. translators: 1: User profile URL.
#: includes/admin/settings/register-settings.php:442

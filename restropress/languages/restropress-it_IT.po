msgid "Check this box to enable debug mode. When enabled, debug messages will be logged and shown in RestroPress &rarr; Tools &rarr; Debug Log."
msgstr "Seleziona questa casella per abilitare la modalità debug. Se abilitata, i messaggi di debug verranno registrati e visualizzati in RestroPress &rarr; Strumenti &rarr; Registro di debug."

#: includes/admin/settings/register-settings.php:1156
msgid "Remove Data on Uninstall?"
msgstr "Rimuovi Dati o Installa?"


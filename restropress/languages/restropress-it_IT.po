msgstr "Seleziona questa opzione per disabilitare tutti gli stili inclusi nei pulsanti, nei campi di pagamento e in tutti gli altri elementi."

#: includes/admin/settings/register-settings.php:967
msgid "Disabling Styles"
msgstr "Disabilitazione degli stili"

#: includes/admin/settings/register-settings.php:968

msgstr "Gebruik de gebruiker met de minste rechten die toch toestemming heeft om toegang te krijgen tot de gegevens of acties die de integratie nodig heeft."

#: includes/admin/settings/register-settings.php:439
msgid "2. Create a WordPress Application Password."
msgstr "2. Maak een WordPress-applicatiewachtwoord aan."

#. translators: 1: User profile URL.
#: includes/admin/settings/register-settings.php:442

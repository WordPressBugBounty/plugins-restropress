msgstr "je WordPress-gebruikersprofiel"

#: includes/admin/settings/register-settings.php:445
msgid "External apps can then authenticate with the WordPress username and Application Password using HTTP Basic Authentication."
msgstr "Externe apps kunnen zich vervolgens authenticeren met de WordPress-gebruikersnaam en het applicatiewachtwoord via HTTP Basic-authenticatie."

#: includes/admin/settings/register-settings.php:446
msgid "3. Call the RestroPress REST endpoints."
msgstr "3. Roep de RestroPress REST-endpoints aan."

#: includes/admin/settings/register-settings.php:447
msgid "The current API includes food items, orders, cart, customers, reports, services/status/tax helpers, categories, and add-ons under the rp/v1 namespace."
msgstr "De huidige API omvat menu-items, bestellingen, winkelwagentje, klanten, rapporten, helpers voor services/status/belasting, categorieën en add-ons onder de naamruimte rp/v1."

#: includes/admin/settings/register-settings.php:449
msgid "Open User Profile"
msgstr "Gebruikersprofiel openen"

#: includes/admin/settings/register-settings.php:451
msgid "View REST API Postman documentation"
msgstr "Postman-documentatie van de REST API bekijken"

#: includes/admin/settings/register-settings.php:457
msgid "About the token endpoint"
msgstr "Over het token-endpoint"

#. translators: 1: REST API auth endpoint URL.
#: includes/admin/settings/register-settings.php:462

#: includes/admin/settings/register-settings.php:401 includes/admin/settings/register-settings.php:404 includes/admin/settings/register-settings.php:1958
msgid "Developer API"
msgstr "Ontwikkelaars-API"

#: includes/admin/settings/register-settings.php:405
msgid "REST API access for custom apps, integrations, and developer workflows."
msgstr "REST API-toegang voor aangepaste apps, integraties en ontwikkelaarsworkflows."

#: includes/admin/settings/register-settings.php:409
msgid "What is available"
msgstr "Wat beschikbaar is"

#: includes/admin/settings/register-settings.php:412
msgid "The Developer API is for custom apps, mobile apps, POS/KDS integrations, reporting tools, and other systems that need to work with RestroPress data through the WordPress REST API."
msgstr "De ontwikkelaars-API is bedoeld voor aangepaste apps, mobiele apps, POS/KDS-integraties, rapportagetools en andere systemen die met RestroPress-gegevens moeten werken via de WordPress REST API."

#. translators: 1: REST API namespace URL.
#: includes/admin/settings/register-settings.php:415
msgid "RestroPress REST endpoints are registered under %1$s and protected endpoints require an authenticated WordPress user with the right permissions."
msgstr "RestroPress REST-endpoints zijn geregistreerd onder %1$s en beschermde endpoints vereisen een geverifieerde WordPress-gebruiker met de juiste rechten."

#: includes/admin/settings/register-settings.php:418
msgid "This page does not create an app, generate credentials automatically, or make order/customer data public by itself."
msgstr "Deze pagina maakt geen app aan, genereert niet automatisch inloggegevens en maakt op zichzelf geen bestel-/klantgegevens openbaar."

#: includes/admin/settings/register-settings.php:424
msgid "Enable Token Endpoint"
msgstr "Token-endpoint inschakelen"

#. translators: 1: REST API auth endpoint URL.
#: includes/admin/settings/register-settings.php:427
